prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: @PROJECT_NAME@
Description: A high-performance algorithm library for sorting and searching
URL: https://github.com/user/algoat
Version: @PROJECT_VERSION@
Requires: nlohmann_json
Cflags: -I${includedir}
Libs: -L${libdir} -lalgoat
